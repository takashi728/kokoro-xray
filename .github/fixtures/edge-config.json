{
  "version": "0.3.0",
  "language": "en",
  "role": "edge",
  "inbound": {
    "mode": "both",
    "vless_encryption": {
      "enabled": true
    },
    "reality": {
      "dest": "www.cloudflare.com:443",
      "server_names": ["www.cloudflare.com"]
    },
    "tls": {
      "domain": "",
      "cdn_domain": "cdn.example.com",
      "acme_email": "admin@example.com"
    }
  },
  "caddy": {
    "version": "2.9.1",
    "use_l4": true
  },
  "multinode": {
    "enabled": true,
    "transport": "vless-pqc",
    "exit_ip": "203.0.113.2",
    "exit_port": 51820,
    "edge_ip": ""
  },
  "tor": {
    "enabled": false,
    "socks_port": 9050
  },
  "routing": {},
  "paths": {
    "xray_config": "/tmp/kokoro-test/config.json",
    "caddyfile": "/tmp/kokoro-test/Caddyfile",
    "xray_bin": "/usr/local/bin/xray",
    "caddy_bin": "/usr/local/bin/caddy",
    "geo_dir": "/usr/local/share/xray"
  }
}
